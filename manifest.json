{
  "manifest_version": 3,
  "name": "Krift Browser Plugin",
  "version": "0.6.1",
  "description": "Detects Kaltura videos on Brightspace and syncs them to Krift.",
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "192": "android-chrome-192x192.png",
    "512": "android-chrome-512x512.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "declarativeContent"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.brightspace.com/*",
    "https://*.kaltura.com/*",
    "https://*.4eng.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "favicon-32x32.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.brightspace.com/*",
        "https://*.kaltura.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": [
        "https://*.brightspace.com/*",
        "https://*.kaltura.com/*"
      ]
    }
  ]
}
